# Copia este archivo como .env y completa los valores reales.
# .env nunca se sube al repositorio (ver .gitignore).

DATABASE_URL="postgresql://usuario:password@host:5432/basededatos?sslmode=require"

JWT_SECRET="reemplaza-esto-por-un-secreto-largo-y-aleatorio"
JWT_EXPIRES_IN="1d"

# Usadas por prisma/seed.js para crear el usuario admin inicial
ADMIN_EMAIL="admin@biblioteca.com"
ADMIN_PASSWORD="CambiarEstaClave123"
ADMIN_NOMBRE="Administrador"

# Origen(es) del frontend permitidos por CORS, separados por coma.
# En producción: la URL de Vercel, ej. https://biblioteca.vercel.app
FRONTEND_URL="http://localhost:5500,http://127.0.0.1:5500"

# Solo producción: Render define PORT automáticamente.
# NODE_ENV="production"
